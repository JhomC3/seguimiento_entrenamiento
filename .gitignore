# Dependencias y entorno
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Caches de testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Bases de datos SQLite (regenerables con /sync)
data/*.db

# Índice del conocimiento (regenerable)
.codebase-memory/

# Sistema
.DS_Store

# Backups locales de la DB
data/backups/

# Token secreto de HealthSync (generado por scripts/start_server.sh)
data/hc_sync_token

# Secreto CSRF persistente (generado por scripts/start_server.sh)
data/csrf_secret

# Proyecto Android (HealthSync)
android/.gradle/
android/app/build/
android/local.properties
android/sdk/
# Symlink al SDK de otro worktree (excepción documentada: solo lectura).
# Con barra solo ignora directorios; sin barra también el enlace simbólico.
android/sdk

# Cache Gradle del directorio raíz (residuo de arranque; el real vive en android/.gradle)
.gradle/

# Working dir local (logs, lighthouse)
.tmp/
.npm/

# Tooling npm (build-time, no runtime)
node_modules/

# Skills y tooling local del agente (no forman parte de la aplicación)
.agents/
.claude/
.opencode/node_modules/
.opencode/skills/
skills-lock.json

# Artefactos locales de Lighthouse CI
.lighthouseci/
