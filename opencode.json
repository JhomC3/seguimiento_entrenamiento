{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "manual",
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": {
      "*": "deny",
      "prompt-refiner": "allow",
      "accessibility": "allow",
      "android-*": "allow",
      "bash-defensive-patterns": "allow",
      "fastapi-*": "allow",
      "frontend-design": "allow",
      "pandas-*": "allow",
      "python-patterns": "allow",
      "python-testing-patterns": "allow",
      "tailwind-css-patterns": "allow"
    },
    "bash": "ask",
    "edit": "ask",
    "task": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny"
  }
}
