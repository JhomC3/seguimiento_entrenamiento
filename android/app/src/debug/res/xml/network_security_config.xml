<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of network_security_config.xml: same HTTPS-only base,
  plus cleartext for explicit development hosts (loopback / emulator host /
  the dev Mac LAN IP for smoke testing). Never mirrored into release: debug
  resources do not ship.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.6</domain>
        <!-- IP actual del Mac (DHCP la cambió de .6 a .5; si vuelve a cambiar,
             añadir la nueva aquí y recompilar: Android no admite rangos). -->
        <domain includeSubdomains="false">192.168.1.5</domain>
    </domain-config>
</network-security-config>
