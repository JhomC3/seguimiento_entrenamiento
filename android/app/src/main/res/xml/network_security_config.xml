<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS-only for release builds. Debug allows cleartext ONLY for explicit
  development hosts (never a global cleartext permission). To add a LAN dev
  host, add a <domain> entry under the debug-config and rebuild.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <debug-overrides>
        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="false">127.0.0.1</domain>
            <domain includeSubdomains="false">10.0.2.2</domain>
        </domain-config>
    </debug-overrides>
</network-security-config>
